PORT=3000
NODE_ENV=development

# ./data/sehatdesk.db locally; /data/sehatdesk.db on Railway once the volume is mounted
DATABASE_PATH=./data/sehatdesk.db

OPENAI_API_KEY=sk-...

# used both to push the initial assistant/tool config and to update it later from the dashboard
VAPI_API_KEY=...
# the specific assistant Update Assistant calls target, set after creating it in Vapi's dashboard
VAPI_ASSISTANT_ID=...
# shared secret checked on incoming Vapi webhook requests, exact mechanism confirmed against Vapi's dashboard at setup time
VAPI_TOOL_WEBHOOK_SECRET=...

# single-admin login for the dashboard's settings page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# signs the session token issued by POST /auth/login
JWT_SECRET=change-me-too

# origin(s) allowed to call the API from a browser (the deployed dashboard's URL)
CORS_ORIGIN=http://localhost:3001
